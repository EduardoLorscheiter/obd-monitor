<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OBDMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- Cores principais -->
        <item name="colorPrimary">@color/primary_dark_mode</item>
        <item name="colorPrimaryVariant">@color/primary_variant_dark_mode</item>
        <item name="colorOnPrimary">@color/on_primary_dark_mode</item>
        <item name="colorSecondary">@color/secondary_dark_mode</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_dark_mode</item>
        <item name="colorPrimaryContainer">@color/primary_container_dark_mode</item>
        <item name="colorSecondaryContainer">@color/secondary_container_dark_mode</item>
        <item name="android:textColorHighlight">@color/primary_variant_dark_mode</item>
        <item name="android:colorControlActivated">@color/primary_variant_dark_mode</item>
        <!-- Cor de fundo de componentes (surface) -->
        <item name="colorSurface">@color/surface_dark_mode</item>
        <item name="colorOnSurface">@color/on_surface_dark_mode</item>
    </style>
</resources>