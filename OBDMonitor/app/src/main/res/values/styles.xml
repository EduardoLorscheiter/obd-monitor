<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonComponent">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/button_background</item>
    </style>

    <style name="SettingsButtonComponent" parent="ButtonComponent">
        <item name="android:src">@drawable/ic_settings</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ConnectButtonComponent" parent="ButtonComponent">
        <item name="android:src">@drawable/ic_connect</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="BackButtonComponent" parent="ButtonComponent">
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="SeparatorComponent">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/separator_background</item>
    </style>
</resources>