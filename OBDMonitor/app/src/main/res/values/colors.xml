<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ======================================================================================= -->
    <!-- Paleta base -->
    <!-- ======================================================================================= -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="green">#00FF00</color>
    <color name="lime">#AEEA00</color>
    <color name="yellow">#FFFF00</color>
    <color name="orange">#FF7A00</color>
    <color name="red">#FF0000</color>
    <color name="off">#2E2E2E</color>
    <color name="dark_grey">#1A1A1A</color>
    <color name="grey">#5F5F5F</color>
    <color name="light_grey">#D1D1D1</color>
    <color name="ios_grey">#A1A1A6</color>
    <color name="light_red">#8E343C</color>
    <color name="dark_red">#280000</color>
    <color name="cold_blue">#42A5F5</color>
    <color name="automotive_green">@android:color/holo_green_light</color>
    <!-- ======================================================================================= -->
    <!-- Transparências -->
    <!-- ======================================================================================= -->
    <color name="black_transparency">#1E000000</color>
    <color name="white_transparency">#1EFFFFFF</color>
    <color name="red_transparency">#80280000</color>
    <color name="limiter">#55FF0000</color>
