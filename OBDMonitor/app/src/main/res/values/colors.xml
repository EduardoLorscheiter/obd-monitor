    <color name="on_primary_light_mode">@color/light_grey</color>
    <color name="secondary_light_mode">@color/dark_red</color>
    <color name="secondary_variant_light_mode">@color/light_red</color>
    <color name="surface_light_mode">@color/black</color>
    <color name="on_surface_light_mode">@color/light_grey</color>
    <color name="primary_container_light_mode">@color/white_transparency</color>
    <color name="secondary_container_light_mode">@color/red_transparency</color>
