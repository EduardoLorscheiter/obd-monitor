    <!-- Led -->
    <!-- ======================================================================================= -->
    <color name="led_off">@color/off</color>
    <color name="led_green">@color/green</color>
    <color name="led_lime">@color/lime</color>
    <color name="led_yellow">@color/yellow</color>
    <color name="led_orange">@color/orange</color>
    <color name="led_red">@color/red</color>
    <!-- ======================================================================================= -->
    <!-- Metric cards -->
    <!-- ======================================================================================= -->
    <color name="metric_card_background">#202020</color>
    <color name="metric_card_stroke">#404040</color>
    <color name="metric_card_value">@color/automotive_green</color>
    <!-- ======================================================================================= -->
    <!-- Status -->
    <!-- ======================================================================================= -->
    <!-- Conexão -->
    <color name="status_off">@color/red</color>
    <color name="status_on">@color/green</color>
    <!-- Temperatura do líquido de arrefecimento -->
    <color name="coolant_cold">@color/cold_blue</color>
    <color name="coolant_normal">@color/automotive_green</color>
    <color name="coolant_warning">@color/yellow</color>
    <color name="coolant_hot">@color/red</color>
    <!-- Temperatura do ar de admissão -->
    <color name="intake_cold">@color/cold_blue</color>
    <color name="intake_normal">@color/automotive_green</color>
    <color name="intake_warning">@color/yellow</color>
    <color name="intake_hot">@color/red</color>
    <!-- Bateria -->
    <color name="battery_low">@color/red</color>
    <color name="battery_warning">@color/yellow</color>
    <color name="battery_normal">@color/automotive_green</color>
    <color name="battery_over">@color/orange</color>
    <!-- ======================================================================================= -->
    <!-- Switch -->
    <!-- ======================================================================================= -->
    <color name="switch_thumb_checked">@color/light_red</color>
    <color name="switch_thumb_unchecked">@color/light_grey</color>
    <color name="switch_track_checked">@color/dark_red</color>
    <color name="switch_track_unchecked">@color/dark_grey</color>
