<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OBDMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- Cores principais -->
        <item name="colorPrimary">@color/colorPrimaryLightMode</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariantLightMode</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryLightMode</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainerLightMode</item>
        <item name="android:textColorHighlight">@color/colorPrimaryVariantLightMode</item>
        <item name="android:colorControlActivated">@color/colorPrimaryLightMode</item>
        <!-- Cor de fundo de componentes (surface) -->
        <item name="colorSurface">@color/colorSurfaceLightMode</item>
        <item name="colorOnSurface">@color/colorOnSurfaceLightMode</item>
    </style>

    <style name="Theme.OBDMonitor" parent="Base.Theme.OBDMonitor" />
</resources>